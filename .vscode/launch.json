{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug cub3d (macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cub3d",
            "args": ["map.cub"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "make: build"
        },
        {
            "name": "Attach to cub3d (macOS)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/cub3d",
            "processId": "${command:pickProcess}",
            "MIMode": "lldb"
        }
    ]
}
